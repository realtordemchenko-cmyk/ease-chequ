# .env.example
# Строка подключения к базе данных (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/prequalrent"

# Ключ для шифрования документов (32 байта в hex)
# Сгенерируй, например: openssl rand -hex 32
DOCUMENTS_AES_KEY="ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff"