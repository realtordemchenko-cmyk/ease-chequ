{
  "name": "ease-chequ",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm dev:frontend",
    "dev:frontend": "cd apps/web && next dev",
    "build": "pnpm build:frontend",
    "build:frontend": "cd apps/web && next build",
    "start": "pnpm start:frontend",
    "start:frontend": "cd apps/web && next start -p 3000",
    "check": "pnpm exec tsc --noEmit && pnpm exec eslint . --ext .ts,.tsx",
    "audit:cruise": "depcruise --config .dependency-cruiser.cjs apps/web --output-type err",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "concurrently": "8.2.2",
    "next": "14.1.0",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@eslint/js": "8.56.0",
    "@typescript-eslint/eslint-plugin": "7.0.0",
    "@typescript-eslint/parser": "7.0.0",
    "dependency-cruiser": "17.1.0",
    "eslint": "8.56.0",
    "eslint-plugin-react": "7.34.0",
    "eslint-plugin-react-hooks": "4.6.0",
    "eslint-plugin-react-refresh": "0.4.6",
    "globals": "16.4.0",
    "typescript": "5.4.5"
  }
}
